---
/**
 * Slim enradig byline för money pages (money page-mallen).
 * Foto + Axel Jönemyr · datum · uppdaterad · lästid på en rad. Lästiden fylls
 * av sidans TOC-script (#article-reading-time). Person JSON-LD inkluderad.
 */
interface Props {
  author?: string;
  authorTitle?: string;
  authorBio?: string;
  authorImage?: string;
  datePublished?: string;
  dateModified?: string;
}

const {
  author = 'Axel Jönemyr',
  authorTitle = 'Grundare och redaktör, Bebisguiden',
  authorBio = 'Axel är trebarnsfar och granskar barnvagnar, bilbarnstolar och babyutrustning utifrån verifierbar data, säkerhet och pris, så svenska föräldrar enklare hittar rätt.',
  authorImage = '/images/axel-jonemyr-2026.webp',
  datePublished,
  dateModified,
} = Astro.props;

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('sv-SE', { day: 'numeric', month: 'long', year: 'numeric' });
};

const showPublished = !!datePublished;
const showUpdated = !!dateModified && dateModified !== datePublished;
---

<!--
  Två iterationer 2026-07-26, båda efter test på riktig iPhone 14. Notera att
  ingen av buggarna gick att se i Chrome DevTools, bara på enheten.

  1. Ursprunget: namn, datum och lästid i EN flex-wrap-rad med fristående "·" som
     egna flex-items mellan sig. När raden bröts hamnade en separator först eller
     sist på raden, alltså en punkt utan något att separera. De var gray-300 och
     nästan osynliga, så felet doldes tills färgerna fick rätt kontrast.

  2. Första fixen delade upp i två block, namn över metadata. Det gav en tom rad
     mellan dem på enheten trots att avståndet mätte 2 px i varje bredd jag kunde
     testa. Orsaken gick inte att återskapa, så jag slutade jaga den.

  3. Andra fixen tog bort punkterna men behöll flexbox. Fortfarande fel på enheten.

  Nu portad från hudbarriärens AuthorByline (compact-läget), som användaren
  bekräftat fungerar rakt av på samma telefon. Det som gör skillnaden är att
  metadatan INTE är flexbox utan en vanlig <p> där texten flödar och bryts som
  text. Så länge posterna är flex-items kan layouten skapa både lösa tecken i
  radkanten och block-avstånd som beter sig olika mellan renderare.

  Två detaljer följer med från förlagan och ska inte "förenklas" bort:
  separatorn ligger INUTI samma nowrap-span som sitt datum, så den reser med
  datumet vid en radbrytning i stället för att bli kvar ensam i kanten. Och bara
  ETT datum visas, uppdaterat när det finns, annars publicerat. Två datum plus
  lästid var det som gjorde raden lång nog att bryta överhuvudtaget.
-->
<div class="flex items-center gap-2.5 py-2 mb-3 border-b border-border">
  <a href="/om-redaktionen/" aria-label={`Om ${author}`} class="shrink-0">
    {authorImage ? (
      <img src={authorImage} alt={author} width="32" height="32" loading="lazy" class="w-8 h-8 rounded-full object-cover" />
    ) : (
      <span class="flex items-center justify-center w-8 h-8 rounded-full bg-bg-alt text-accent-dark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-[18px] h-[18px]"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 9.75h6M9 12h6m-6 2.25h3"/></svg>
      </span>
    )}
  </a>
  <p class="min-w-0 text-xs text-text-light leading-snug">
    <a href="/om-redaktionen/" class="font-semibold text-text hover:text-accent transition-colors">{author}</a>
    {(showUpdated || showPublished) && (
      <span class="whitespace-nowrap">
        <span class="mx-1.5" aria-hidden="true">·</span>
        {showUpdated ? 'Uppdaterad ' : 'Publicerad '}
        <time datetime={showUpdated ? dateModified : datePublished}>{formatDate((showUpdated ? dateModified : datePublished)!)}</time>
      </span>
    )}
    {/* Lästidens separator ligger som ::before på elementet självt (global.css),
        inte som ett eget syskon. Skälet: sr-only tas bort av TOC-scriptet först
        när lästiden räknats ut. En fristående punkt hade synts som en lös prick
        innan dess, och för alltid om scriptet inte kör. */}
    <span id="article-reading-time" class="sr-only">Beräknar lästid...</span>
  </p>
</div>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://bebisguiden.se/om-redaktionen/#person',
  name: author,
  url: 'https://bebisguiden.se/om-redaktionen/',
  description: authorBio,
  jobTitle: authorTitle,
  worksFor: { '@type': 'Organization', '@id': 'https://bebisguiden.se/#organization', name: 'Bebisguiden', url: 'https://bebisguiden.se' },
  sameAs: [
    'https://www.instagram.com/axlpxl/',
    'https://www.strava.com/athletes/2699302',
    'https://www.linkedin.com/in/axel-j%C3%B6nemyr-ba1443170/',
    'https://www.facebook.com/axel.jonemyr/',
  ],
  ...(authorImage ? { image: `https://bebisguiden.se${authorImage}` } : {}),
  knowsAbout: ['barnprodukter', 'bilbarnstolar', 'barnvagnar', 'matstolar', 'barnsäkerhet', 'amning', 'EN 14988', 'i-Size']
})} />
