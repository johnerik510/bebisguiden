---

<!-- E-E-A-T-rad: icke-sticky, scrollar bort och äter inte above the fold -->
<div class="hidden md:block bg-primary text-white/85 text-sm">
 <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-9 flex items-center justify-between">
  <p class="flex items-center gap-5">
   {uspItems.map((item, i) => (
    <span class={`flex items-center gap-1.5 ${i > 2 ? 'hidden xl:flex' : ''}`}>
     <svg class="w-3.5 h-3.5 text-accent-light flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
     {item}
    </span>
   ))}
  </p>
  <span class="flex items-center gap-4">
   <a href="/sa-testar-vi/" class="hover:text-white transition-colors">Så jämför vi</a>
   <span class="text-white/30" aria-hidden="true">·</span>
   <a href="/om-redaktionen/" class="hover:text-white transition-colors">Om redaktionen</a>
  </span>
 </div>
</div>

<header class="sticky top-0 z-50" id="site-header">
 <div class="bg-white/95 border-b border-border" style="backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
   <div class="flex items-center justify-between h-16">

    <a href="/" class="flex items-center flex-shrink-0">
     <img src="/images/logo.svg" alt="Bebisguiden" class="h-8 w-auto" width="181" height="32" />
    </a>

    <!-- Desktop mega-nav -->
    <nav class="hidden lg:flex items-stretch h-16" aria-label="Huvudnavigering">
     {navItems.map((item) => (
      <div class="mega-item group static flex items-stretch">
       <a
        href={item.href}
        class="relative px-3 h-16 inline-flex items-center text-[15px] font-semibold text-text-light whitespace-nowrap transition-colors group-hover:text-primary group-focus-within:text-primary"
        aria-haspopup="true"
       >
        {item.label}
        <span class="pointer-events-none absolute left-3 right-3 -bottom-px h-0.5 bg-accent scale-x-0 group-hover:scale-x-100 group-focus-within:scale-x-100 origin-left transition-transform duration-200 motion-reduce:transition-none" aria-hidden="true"></span>
       </a>

       <div class="mega-panel absolute left-0 right-0 top-full z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-opacity duration-150 motion-reduce:transition-none">
        <div class="bg-white border border-border border-t-0 rounded-b-lg shadow-xl overflow-hidden">
         <div class="grid grid-cols-12">
          <div class={`col-span-12 ${item.featured ? 'lg:col-span-9' : 'lg:col-span-12'} p-7`}>
           <div class={`grid gap-x-8 gap-y-6 ${item.columns.length === 2 ? 'grid-cols-2' : 'grid-cols-3'}`}>
            {item.columns.map((col) => (
             <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-text-light mb-3 pb-2 border-b border-border">{col.title}</p>
              <ul class="space-y-0.5">
               {col.links.map((link) => (
                <li>
                 <a href={link.href} class="block py-1.5 text-[15px] text-text hover:text-accent transition-colors">{link.label}</a>
                </li>
               ))}
              </ul>
             </div>
            ))}
           </div>
          </div>

          {item.featured && (
           <div class="hidden lg:block lg:col-span-3 bg-bg p-6 border-l border-border">
            <span class="inline-block text-xs font-bold uppercase tracking-wider text-accent-dark mb-3">{item.featured.eyebrow}</span>
            <a href={item.featured.href} class="block group/feat">
             <img src={item.featured.img} alt={item.featured.title} width="240" height="128" loading="lazy" class="w-full h-32 rounded-lg bg-white border border-border mb-3 object-contain p-3" />
             <p class="font-heading font-semibold text-primary text-base leading-snug group-hover/feat:text-accent transition-colors">{item.featured.title}</p>
            </a>
            <p class="text-sm text-text-light leading-relaxed mt-1.5 mb-4">{item.featured.blurb}</p>
            <a href={item.featured.href} class="inline-flex items-center justify-center w-full border border-border bg-white hover:border-accent hover:text-accent text-primary font-semibold py-2.5 px-4 rounded-md transition-colors text-sm">
             {item.featured.ctaLabel}
            </a>
           </div>
          )}
         </div>

         <div class="flex items-center justify-between gap-4 px-7 py-3 bg-bg-alt border-t border-border text-[13px] text-text-light">
          <span class="flex items-center gap-2">
           <svg class="w-3.5 h-3.5 text-accent-dark flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
           {item.trust}
          </span>
          <a href="/sa-testar-vi/" class="font-semibold text-accent-dark hover:text-accent transition-colors whitespace-nowrap">Så jämför vi</a>
         </div>
        </div>
       </div>
      </div>
     ))}
    </nav>

    <!-- Höger: sök + checklista -->
    <div class="hidden lg:flex items-center gap-1 flex-shrink-0">
     <button
      id="search-open-desktop"
      class="p-2.5 rounded-md text-text-light hover:text-accent hover:bg-bg-alt transition-colors flex items-center justify-center"
      aria-label="Sök"
      title="Sök (Ctrl+K)"
     >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
     </button>
    </div>

    <!-- Mobil: sök + hamburgare -->
    <div class="lg:hidden flex items-center gap-0.5">
     <button
      id="search-open-mobile"
      class="p-2.5 rounded-md text-text-light hover:text-accent hover:bg-bg-alt transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
      aria-label="Sök"
     >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
     </button>

     <button
      id="mobile-menu-btn"
      class="p-2.5 rounded-md hover:bg-bg-alt transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center text-primary"
      aria-label="Öppna meny"
      aria-expanded="false"
      aria-controls="mobile-menu"
     >
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
     </button>
    </div>

   </div>
  </div>
 </div>

 <!-- Mobilmeny: kolumn-accordion -->
 <nav id="mobile-menu" class="hidden lg:hidden fixed inset-x-0 bottom-0 z-[60] bg-white border-t border-border overflow-y-auto overscroll-contain" aria-label="Mobilnavigering">
  <div class="px-4 py-2 pb-[max(1.5rem,env(safe-area-inset-bottom))] divide-y divide-border">
   {navItems.map((item, i) => (
    <div class="mobile-section py-1">
     <button
      class="mobile-toggle w-full flex items-center justify-between py-3.5 text-[15px] font-semibold text-primary"
      aria-expanded="false"
      data-index={i}
     >
      <span>{item.label}</span>
      <svg class="toggle-chevron w-4 h-4 opacity-50 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
     </button>
     <div class="mobile-dropdown hidden pb-3">
      {item.columns.map((col) => (
       <div class="mt-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-text-light mt-3 mb-1">{col.title}</p>
        {col.links.map((link) => (
         <a href={link.href} class="block pl-3 py-2 text-[15px] text-text hover:text-accent border-l-2 border-border hover:border-accent transition-colors">{link.label}</a>
        ))}
       </div>
      ))}
     </div>
    </div>
   ))}
   <div class="py-3 flex flex-col gap-2">
    <a href="/sa-testar-vi/" class="flex items-center gap-2 py-2 text-[15px] font-semibold text-primary">
     <svg class="w-4 h-4 text-accent-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
     Så jämför vi
    </a>
   </div>
  </div>
 </nav>
</header>

<SearchModal />

<script>
 // Mobilmeny
 const btn = document.getElementById('mobile-menu-btn');
 const menu = document.getElementById('mobile-menu');
 const iconOpen = document.getElementById('menu-icon-open');
 const iconClose = document.getElementById('menu-icon-close');
 const siteHeader = document.getElementById('site-header');

 // Menyn ligger fixed och ska fylla ytan under headerraden hela vägen ner
 const positionMenu = () => {
  if (menu && siteHeader) menu.style.top = `${siteHeader.getBoundingClientRect().bottom}px`;
 };

 const setMenu = (open: boolean) => {
  if (!menu || !btn) return;
  if (open) positionMenu();
  menu.classList.toggle('hidden', !open);
  iconOpen?.classList.toggle('hidden', open);
  iconClose?.classList.toggle('hidden', !open);
  btn.setAttribute('aria-expanded', String(open));
  document.body.style.overflow = open ? 'hidden' : '';
 };

 btn?.addEventListener('click', () => {
  setMenu(menu?.classList.contains('hidden') ?? false);
 });

 document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) setMenu(false);
 });

 window.addEventListener('resize', () => {
  if (!menu || menu.classList.contains('hidden')) return;
  if (window.innerWidth >= 1024) setMenu(false);
  else positionMenu();
 });

 // Mobil accordion
 document.querySelectorAll('.mobile-toggle').forEach((toggle) => {
  toggle.addEventListener('click', () => {
   const section = toggle.closest('.mobile-section');
   const dropdown = section?.querySelector('.mobile-dropdown');
   const chevron = toggle.querySelector('.toggle-chevron');
   const isOpen = !dropdown?.classList.contains('hidden');

   dropdown?.classList.toggle('hidden', isOpen);
   chevron?.classList.toggle('rotate-180', !isOpen);
   toggle.setAttribute('aria-expanded', String(!isOpen));
  });
 });

 // Sök
 function openSearch() {
  if (typeof (window as any).openBebisSearch === 'function') {
   (window as any).openBebisSearch();
  }
 }

 document.getElementById('search-open-desktop')?.addEventListener('click', openSearch);
 document.getElementById('search-open-mobile')?.addEventListener('click', openSearch);
</script>
