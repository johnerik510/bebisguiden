---
import { ctaRel } from '../lib/cta-rel';
import { getPrice } from '../lib/price';
import PriceTag from './PriceTag.astro';
interface Props {
  text?: string;
  href: string;
  productName?: string;
  /** Butiken länken går till. Krävs när visaPris är satt. */
  store?: string;
  /**
   * Visa butikens pris i baren och byt knapptext till "Handla hos [Butik]".
   * Priset kommer ur produktfeeden via lib/price.ts. Saknas produkten i feeden
   * renderas ingen siffra och texten faller tillbaka på standardformuleringen,
   * så baren kan aldrig hamna i läget "pris intill en Bra pris-knapp".
   */
  visaPris?: boolean;
  /** Legacy-props, ignoreras */
  brand?: string;
}

const { text, href, productName, store, visaPris = false } = Astro.props;

/* Knapptexten härleds ur priset i stället för att skickas in som sträng. Står
 * beloppet intill knappen är "Bra pris" ett omdöme vi inte kan belägga
 * (CLAUDE.md, CTA-standarder), och texten och prisvisningen kan aldrig glida
 * isär eftersom båda kommer ur samma uppslag. */
const pris = visaPris ? getPrice(href) : null;
const ctaText = text || (store ? `${pris ? 'Handla' : 'Bra pris'} hos ${store}` : 'Se erbjudande');
---

<div
  id="sticky-cta"
  class="not-prose fixed left-0 right-0 z-40 lg:hidden translate-y-full transition-transform duration-300 ease-in-out"
  style="bottom: 0;"
>
  <div
    class="bg-white border-t border-border shadow-2xl px-4"
    style="padding-top: 0.5rem; padding-bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));"
  >
    {productName && (
    <p class="text-[11px] text-text-light leading-tight mb-1.5 truncate">
      <span class="font-semibold text-cta uppercase tracking-wide">Bäst i test:</span> {productName}
    </p>
    )}
    {visaPris && <PriceTag affiliateUrl={href} merchant={store} variant="inline" class="mb-1.5" />}
    <a
      href={href}
      rel={ctaRel(href)}
      target="_blank"
      data-product={productName}
      class="block w-full text-center bg-cta hover:bg-cta-dark text-white font-bold text-base px-5 py-3 rounded-lg transition-colors"
    >
      {ctaText}
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById('sticky-cta');
  if (!bar) throw new Error('sticky-cta missing');

  let visible = false;

  const show = () => { if (!visible) { visible = true; bar.classList.remove('translate-y-full'); } };
  const hide = () => { if (visible) { visible = false; bar.classList.add('translate-y-full'); } };

  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) show();
    else if (window.scrollY < 200) hide();
  }, { passive: true });

  const vv = window.visualViewport;
  if (vv) {
    const pin = () => {
      const gap = Math.max(0, window.innerHeight - (vv.offsetTop + vv.height));
      bar.style.bottom = `${gap}px`;
    };
    vv.addEventListener('resize', pin, { passive: true });
    vv.addEventListener('scroll', pin, { passive: true });
    pin();
  }
</script>
