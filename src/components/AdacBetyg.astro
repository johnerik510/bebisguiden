---
/**
 * ADAC-betygspanel (money page-mallen, ADAC-tillägget 2026-07-27).
 * Visar ADAC Kindersitztest-resultatet i detalj: totalbetyg med svenskt
 * omdömesord, skallinjal som förklarar den tyska skalan (lägre = bättre),
 * fyra kategorirader (expanderbara när delkriterier finns) och källrad.
 * Data kommer ALLTID från src/data/adac-scores.ts (verifierad, NOLLTOLERANS).
 */
import type { AdacScore } from '../data/adac-scores';
import { adacWord, adacColor, adacFmt } from '../data/adac-scores';

interface Props {
  data: AdacScore;
}

const { data } = Astro.props;

const categories: { label: string; score: number; subKey: 'sicherheit' | 'bedienung' | 'ergonomie' | 'schadstoffe' }[] = [
  { label: 'Säkerhet', score: data.sicherheit, subKey: 'sicherheit' },
  { label: 'Hantering', score: data.bedienung, subKey: 'bedienung' },
  { label: 'Ergonomi', score: data.ergonomie, subKey: 'ergonomie' },
  { label: 'Skadliga ämnen', score: data.schadstoffe, subKey: 'schadstoffe' },
];

const word = adacWord(data.overall);
const color = adacColor(data.overall);
// Markörposition på skalan 0,6-5,5
const markerPct = Math.min(100, Math.max(0, ((data.overall - 0.6) / 4.9) * 100));
const scaleSteps = [
  { word: 'mycket bra', color: '#35604a' },
  { word: 'bra', color: '#6d8a3f' },
  { word: 'tillfredsställande', color: '#b45309' },
  { word: 'tillräcklig', color: '#a3441c' },
  { word: 'otillräcklig', color: '#9e2a2b' },
];
const activeStep = word.toLowerCase();
// Utan delkriterier renderas kategorierna som kompakt grid (2x2 mobil, 4-i-rad desktop).
// Finns delkriterier för någon kategori används expanderbara rader för alla.
const hasSubs = categories.some((c) => (data.subScores?.[c.subKey]?.length ?? 0) > 0);
---

<div class="not-prose bg-white border border-border rounded-lg overflow-hidden my-5">
  {/* Huvud: kicker + testad konfiguration + totalbetygschip med ord inbakat */}
  <div class="flex items-start justify-between gap-3 px-4 sm:px-5 pt-3 pb-2">
    <div class="min-w-0">
      <p class="text-[11px] font-bold uppercase tracking-wider text-text-light">ADAC Kindersitztest {data.testYear}</p>
      <p class="font-heading text-base sm:text-lg font-bold text-primary leading-snug">{data.testedConfiguration}</p>
    </div>
    <span class="inline-flex items-baseline gap-1.5 flex-shrink-0 font-heading font-extrabold text-white rounded-md px-2.5 py-1 mt-0.5" style={`background:${color}`}>
      <span class="text-sm sm:text-base">{word}</span>
      <span class="text-lg sm:text-xl tabular-nums">{adacFmt(data.overall)}</span>
    </span>
  </div>

  {/* Skallinjal: förklarar den tyska skalan visuellt */}
  <div class="px-4 sm:px-5 pb-2.5 border-b border-border">
    <div class="hidden sm:flex justify-between gap-2 text-xs text-text-light mb-1">
      <span><strong class="font-bold text-text">Tysk betygsskala:</strong> 0,6 är bäst, 5,5 är sämst</span>
      <span class="whitespace-nowrap">lägre siffra = bättre</span>
    </div>
    <div class="adac-track relative flex gap-0.5 h-2 mt-2.5" role="img" aria-label={`Betyget ${adacFmt(data.overall)} ligger i steget ${word.toLowerCase()} på ADAC:s skala från 0,6 (bäst) till 5,5 (sämst)`}>
      {scaleSteps.map((s, i) => (
        <span
          class="flex-1"
          style={`background:${s.color};${i === 0 ? 'border-radius:999px 0 0 999px;' : ''}${i === 4 ? 'border-radius:0 999px 999px 0;' : ''}`}
        ></span>
      ))}
      <span class="adac-marker" style={`left:${markerPct}%`} aria-hidden="true"></span>
    </div>
    {/* Mobil: ändetiketter + aktivt ord. Desktop: alla fem skalstegen. */}
    <div class="sm:hidden flex justify-between items-baseline mt-1 text-[11px] text-text-light">
      <span>0,6 = bäst</span>
      <span class="font-bold text-text text-xs">{word.toLowerCase()}</span>
      <span>5,5 = sämst</span>
    </div>
    <div class="hidden sm:grid grid-cols-5 text-center mt-1.5 text-[11.5px] leading-tight text-text-light">
      {scaleSteps.map((s) => (
        <span class:list={[{ 'font-bold text-text': s.word === activeStep }]}>{s.word}</span>
      ))}
    </div>
  </div>

  {/* Kategorier. Utan delkriterier: kompakt grid (2x2 mobil, 4-i-rad desktop).
      Med delkriterier: expanderbara rader. */}
  {!hasSubs ? (
  <div class="grid grid-cols-2 sm:grid-cols-4">
    {categories.map((cat, i) => (
      <div class:list={[
        'px-4 sm:px-5 py-2 border-border',
        { 'border-r': i % 2 === 0 },
        { 'border-b sm:border-b-0': i < 2 },
        { 'sm:border-r': i === 1 || i === 2 },
      ]}>
        <p class="text-xs text-text-light leading-tight">{cat.label}</p>
        <p class="flex items-center gap-1.5 mt-0.5">
          <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background:${adacColor(cat.score)}`}></span>
          <span class="font-bold tabular-nums text-[15px]">{adacFmt(cat.score)}</span>
          <span class="hidden lg:inline text-xs text-text-light">{adacWord(cat.score).toLowerCase()}</span>
        </p>
      </div>
    ))}
  </div>
  ) : (
  categories.map((cat) => {
    const subs = data.subScores?.[cat.subKey];
    const catColor = adacColor(cat.score);
    const catWord = adacWord(cat.score).toLowerCase();
    return subs && subs.length > 0 ? (
      <details class="border-b border-border last:border-b-0 group">
        <summary class="flex items-center justify-between gap-3 px-4 sm:px-5 py-2.5 cursor-pointer list-none hover:bg-bg [&::-webkit-details-marker]:hidden">
          <span class="font-semibold text-text">{cat.label}</span>
          <span class="flex items-center gap-2.5">
            <span class="hidden sm:inline text-[13px] text-text-light">{catWord}</span>
            <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style={`background:${catColor}`}></span>
            <span class="font-bold tabular-nums text-[15px] min-w-[28px] text-right">{adacFmt(cat.score)}</span>
            <svg class="w-4 h-4 text-text-light transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </span>
        </summary>
        <div class="bg-bg border-t border-border px-4 sm:px-5 py-2">
          {subs.map((sub) => (
            <div class="flex items-center justify-between py-1.5 text-sm text-text-light border-b border-dashed border-border-dark last:border-b-0">
              <span>{sub.label}</span>
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background:${adacColor(sub.score)}`}></span>
                <span class="font-semibold tabular-nums text-[13.5px]">{adacFmt(sub.score)}</span>
              </span>
            </div>
          ))}
        </div>
      </details>
    ) : (
      <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-2.5 border-b border-border last:border-b-0">
        <span class="font-semibold text-text">{cat.label}</span>
        <span class="flex items-center gap-2.5">
          <span class="hidden sm:inline text-[13px] text-text-light">{catWord}</span>
          <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style={`background:${catColor}`}></span>
          <span class="font-bold tabular-nums text-[15px] min-w-[28px] text-right">{adacFmt(cat.score)}</span>
          <span class="w-4" aria-hidden="true"></span>
        </span>
      </div>
    );
  })
  )}

  {/* Källrad: not + källa i samma flöde för lägre höjd */}
  <div class="bg-bg-alt border-t border-border px-4 sm:px-5 py-2 text-[12.5px] leading-snug text-text-light">
    {data.configNote && <>{data.configNote}{' '}</>}Källa: <a href={data.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-accent font-semibold hover:text-accent-dark underline">ADAC Kindersitztest {data.testYear}</a> · verifierad {data.verifiedDate}
  </div>
</div>

<style>
  .adac-marker {
    position: absolute;
    top: -9px;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 8px solid var(--color-primary);
  }
</style>
