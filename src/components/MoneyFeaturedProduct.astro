---
import { ctaRel } from '../lib/cta-rel';
/**
 * Featured-block för redaktionens topp-rekommendation på money pages.
 * Trogen port av tillskottsguidens HSNGFeaturedProduct (money page-mallen),
 * tematiserad till bebisguiden och utan resolveMultiCTA-beroende: sidan
 * skickar in primary-URL + ev. alsoAt-butiker direkt (verifierade feeds).
 */
import { getPrice } from '../lib/price';
import PriceTag from './PriceTag.astro';

interface AlsoAt {
  store: string;
  url: string;
}

interface Props {
  brand: string;
  name: string;
  /** Se MoneyProductCard.visaPris. Priset kommer ur feeden, aldrig ur en prop. */
  visaPris?: boolean;
  image: string;
  imageAlt?: string;
  trackedUrl: string;
  store: string;
  description: string;
  badge?: string;
  alsoAt?: AlsoAt[];
}

const {
  brand,
  name,
  visaPris = false,
  image,
  imageAlt,
  trackedUrl,
  store,
  description,
  badge = 'Redaktionens val',
  alsoAt = [],
} = Astro.props;

/* Priset avgör knappens text: står beloppet intill knappen är "Bra pris" ett
 * omdöme vi inte kan belägga (CLAUDE.md, CTA-standarder). */
const pris = visaPris ? getPrice(trackedUrl) : null;
const ctaText = `${pris ? 'Handla' : 'Bra pris'} hos ${store}`;

/**
 * Märket i rubriken i stället för som egen versaletikett ovanför. Många
 * produktnamn bär redan märket ("Cybex EOS Lux Duovagn"), så lägg bara till det
 * när namnet inte redan börjar med det, annars blir det "Cybex Cybex EOS Lux".
 */
const rubrik = brand && !name.toLowerCase().startsWith(brand.toLowerCase())
  ? `${brand} ${name}`
  : name;
---

<!--
  Omgjord 2026-07-26: accentstrimman borttagen. Kortet skiljs nu från vanliga
  produktkort med en mörkare hårlinje hela vägen runt, och badgen ("Redaktionens
  val") gör det semantiska jobbet. Det är etiketten som säger att detta är valet,
  inte ett färgat band i kanten.
-->
<div class="not-prose my-6 bg-white border border-border-dark rounded-lg p-5 sm:p-6">
  <span class="inline-flex items-center rounded-full bg-primary text-white text-xs font-semibold uppercase tracking-wider px-3 py-1 mb-4">
    {badge}
  </span>
  <div class="flex flex-col sm:flex-row gap-4 sm:gap-5">
    <div class="flex-shrink-0 mx-auto sm:mx-0">
      <a href={trackedUrl} rel={ctaRel(trackedUrl)} target="_blank" class="block w-32 h-32 sm:w-36 sm:h-36 rounded-lg bg-white border border-border overflow-hidden">
        <img
          src={image}
          alt={imageAlt || `${brand} ${name}`}
          loading="eager"
          width="144"
          height="144"
          class="w-full h-full object-contain p-2"
        />
      </a>
    </div>
    <div class="flex-1 min-w-0">
      <!--
        Märket satt tidigare som en egen versaletikett ovanför rubriken. Med badgen
        ovanför blev det två versalrader innan läsaren nådde produktnamnet. Märket
        hör hemma i namnet, det är en del av vad produkten heter, inte en kategori.
      -->
      <h2 class="font-heading text-lg sm:text-xl font-bold text-text leading-tight mb-2">
        <a href={trackedUrl} rel={ctaRel(trackedUrl)} target="_blank" class="!text-text hover:!text-accent-dark transition-colors no-underline">{rubrik}</a>
      </h2>
      <p class="text-[15px] text-text-light leading-relaxed mb-3">{description}</p>
      <div class="flex flex-wrap items-center gap-3">
        {visaPris && <PriceTag affiliateUrl={trackedUrl} merchant={store} variant="card" />}
        <div class="w-full">
          <a
            href={trackedUrl}
            rel={ctaRel(trackedUrl)}
            target="_blank"
            data-product={name}
            class="inline-flex w-full items-center justify-center gap-2 px-5 py-3 bg-cta hover:bg-cta-dark text-white font-bold text-base rounded-md transition-colors no-underline"
          >
            {ctaText}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        </div>
      </div>
      {alsoAt.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 mt-3">
        <span class="text-xs font-semibold text-text-light">Även hos:</span>
        {alsoAt.map((o) => (
        <a
          href={o.url}
          rel={ctaRel(o.url)}
          target="_blank"
          class="inline-flex items-center px-3 py-1.5 rounded-lg bg-white border border-border text-xs font-semibold text-text-light hover:border-accent-dark hover:text-accent-dark transition-colors no-underline"
        >
          {o.store}
        </a>
        ))}
      </div>
      )}
    </div>
  </div>
</div>
