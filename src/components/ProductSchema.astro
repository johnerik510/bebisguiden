---
import { offerSchema } from '../lib/offer';

interface ProductItem {
 name: string;
 description?: string;
 image?: string;
 brand?: string;
 ratingValue?: number;
 reviewCount?: number;
 reviewBody?: string;
 pros?: string[];
 cons?: string[];
 /** Produktens affiliate-URL. Ger Offer när butikens pris syns på sidan. */
 affiliateUrl?: string;
 /** Butiken priset gäller hos. */
 store?: string;
}

interface Props {
 products: ProductItem[];
}

const { products } = Astro.props;

/*
 * Offer byggs av lib/offer.ts ur samma feed-uppslag som PriceTag, och bara när
 * sidan faktiskt visar beloppet. Komponenten byggde tidigare ett eget
 * Offer-block med fri frakt och 30 dagars fri retur inskrivet som konstanter.
 * De villkoren är butikens, inte våra, och gick inte att belägga för någon av
 * butikerna: att utfästa dem i schemat är ett faktapåstående vi inte äger.
 * Utan dem är noden ett Product snippet med pris, vilket är rätt form för en
 * jämförelsesida som inte är säljare.
 */
const schemas = products.map((product) => ({
 "@context": "https://schema.org",
 "@type": "Product",
 "name": product.name,
 "description": product.description || product.name,
 "image": product.image || `https://bebisguiden.se/og-default.png`,
 "brand": {
 "@type": "Brand",
 "name": product.brand || "Okänt",
 },
...(product.ratingValue? {
 "aggregateRating": {
 "@type": "AggregateRating",
 "ratingValue": product.ratingValue,
 "bestRating": 5,
 "worstRating": 1,
 "reviewCount": product.reviewCount || 1,
 },
 }: {}),
 ...offerSchema(product.affiliateUrl, product.store, Astro.url.pathname),
 "review": {
 "@type": "Review",
 "reviewRating": {
 "@type": "Rating",
 "ratingValue": product.ratingValue || 4,
 "bestRating": 5,
 },
 "author": {
 "@type": "Person",
 "@id": "https://bebisguiden.se/om-redaktionen/#person",
 "name": "Axel Jönemyr",
 "url": "https://bebisguiden.se/om-redaktionen/",
 },
...(product.reviewBody? { "reviewBody": product.reviewBody }: {}),
...(product.pros && product.pros.length > 0? {
 "positiveNotes": {
 "@type": "ItemList",
 "itemListElement": product.pros.map((pro, i) => ({ "@type": "ListItem", "position": i + 1, "name": pro })),
 },
 }: {}),
...(product.cons && product.cons.length > 0? {
 "negativeNotes": {
 "@type": "ItemList",
 "itemListElement": product.cons.map((con, i) => ({ "@type": "ListItem", "position": i + 1, "name": con })),
 },
 }: {}),
 },
}));
---

{schemas.map((schema) => (
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
