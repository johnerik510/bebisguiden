---
/**
 * Footer (omgjord 2026-07-26 enligt best practice + isk-guidens mönster).
 *
 * Vad som ändrades och varför:
 *  - Länkdumpen bantades från 38 till 26 länkar. Djupet bärs av hubbsidorna
 *    (/kategorier/, /guider/, /marken/), inte av footern. En footer med 38
 *    likvärdiga länkar sprider länkvärde tunt och ingen läser den.
 *  - Kolumnerna är GSC-sorterade, inte alfabetiska. "Mest lästa" listar sitens
 *    faktiska toppsidor (blöjor 850 klick/90d, bilbarnstolar 721, barnvagnar 712,
 *    bedside crib 185, nappflaskor 187, bärsele nyfödd 102).
 *  - Kontrastfix: gamla footern körde text-text mot mörk plommon-ink, cirka
 *    1,9:1 kontrast. Allt är nu vit-opacitet mot bandet och klarar WCAG AA.
 *  - E-postlänken är borta ur markupen. Adressen sätts ihop i runtime av
 *    .js-email-scriptet i BaseLayout, så Cloudflares Email Obfuscation aldrig
 *    kan skapa en /cdn-cgi/l/email-protection-404 som Ahrefs flaggar.
 *  - Affiliate-disclosuren ligger kvar HÄR och bara här (nätverksregel), på en
 *    rad, låg emfas men läsbar.
 */
const mestLasta = [
 { label: 'Bästa blöjorna', href: '/blojor/' },
 { label: 'Bästa bilbarnstolen', href: '/bilbarnstolar/' },
 { label: 'Bästa barnvagnen', href: '/barnvagnar/' },
 { label: 'Bedside crib', href: '/spjalsangar/bedside-crib/' },
 { label: 'Nappflaskor', href: '/amning/nappflaska/' },
 { label: 'Bärsele för nyfödd', href: '/barselen/nyfodd/' },
];

const kategorier = [
 { label: 'Babyvakter', href: '/babyvakter/' },
 { label: 'Matstolar', href: '/matstolar/' },
 { label: 'Spjälsängar', href: '/spjalsangar/' },
 { label: 'Sovpåsar', href: '/sovsackar/' },
 { label: 'Säkerhet hemma', href: '/sakerhet/' },
 { label: 'Alla 16 kategorier', href: '/kategorier/' },
];

const guider = [
 { label: 'Barnvagn på flyget', href: '/guider/barnvagn-flyg/' },
 { label: 'Bilbarnstolsregler', href: '/guider/bilbarnstol-regler/' },
 { label: 'Blöjstorlekar efter vikt', href: '/blojor/storlek-guide/' },
 { label: 'Checklista inför bebis', href: '/guider/bebis-checklista/' },
 { label: 'Alla märken', href: '/marken/' },
 { label: 'Alla guider', href: '/guider/' },
];

const omOss = [
 { label: 'Om Bebisguiden', href: '/om-oss/' },
 { label: 'Om redaktionen', href: '/om-redaktionen/' },
 { label: 'Så jämför vi', href: '/sa-testar-vi/' },
 { label: 'Redaktionell policy', href: '/redaktionell-policy/' },
 { label: 'Kontakt', href: '/kontakt/' },
 { label: 'Integritetspolicy', href: '/integritetspolicy/' },
];

const kolumner = [
 { rubrik: 'Mest lästa', lankar: mestLasta },
 { rubrik: 'Kategorier', lankar: kategorier },
 { rubrik: 'Guider och märken', lankar: guider },
 { rubrik: 'Om oss', lankar: omOss },
];

const ar = new Date().getFullYear();
---

<footer class="bg-primary text-white/70">
 <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 lg:gap-10">

   <div class="col-span-2 md:col-span-3 lg:col-span-1">
    <p class="font-heading text-white text-lg font-semibold mb-3">Bebisguiden</p>
    <p class="text-[15px] leading-relaxed text-white/70">
     Oberoende svensk redaktion som granskar och rangordnar barnprodukter. Vi säljer inga egna produkter och låter aldrig tillverkare påverka omdömena.
    </p>
    <div class="flex gap-3 mt-5">
     <a href="https://www.facebook.com/profile.php?id=61589077420466" target="_blank" rel="noopener noreferrer" aria-label="Bebisguiden på Facebook" class="text-white/60 hover:text-white transition-colors">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
     </a>
     <a href="https://www.tiktok.com/@bebisguiden.se" target="_blank" rel="noopener noreferrer" aria-label="Bebisguiden på TikTok" class="text-white/60 hover:text-white transition-colors">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.88a8.25 8.25 0 004.84 1.55V7.01a4.85 4.85 0 01-1.07-.32z"/></svg>
     </a>
    </div>
   </div>

   {kolumner.map((kol) => (
    <div>
     <p class="text-xs font-semibold uppercase tracking-wider text-white/50 mb-4">{kol.rubrik}</p>
     <ul class="space-y-2.5">
      {kol.lankar.map((item) => (
       <li>
        <a href={item.href} class="text-[15px] text-white/75 hover:text-white transition-colors">{item.label}</a>
       </li>
      ))}
     </ul>
    </div>
   ))}

  </div>

  <div class="mt-12 pt-6 border-t border-white/15 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between text-[13px] text-white/55">
   <p>
    &copy; {ar} Bebisguiden.se &middot; ELS Catalyst AB &middot; Org.nr 559583-6163 &middot;
    <span class="js-email" data-u="info" data-d="bebisguiden.se" data-class="underline underline-offset-2 hover:text-white transition-colors"></span>
   </p>
   <p class="lg:text-right lg:max-w-md">
    Bebisguiden innehåller affiliatelänkar. Vi kan få provision när du handlar via dem, utan extra kostnad för dig.
    <a href="/affiliate-disclaimer/" class="underline underline-offset-2 hover:text-white transition-colors">Så finansieras Bebisguiden</a>.
   </p>
  </div>
 </div>
</footer>
