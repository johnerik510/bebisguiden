---
/**
 * Callout, standardiserad informationsbox.
 *
 * Användning:
 * <Callout type="tip" title="Tips">Innehåll</Callout>
 * <Callout type="warning">Varning utan titel</Callout>
 *
 * type: 'tip' | 'warning' | 'key' | 'info'
 */
interface Props {
 type?: 'tip' | 'warning' | 'key' | 'info';
 title?: string;
}

const { type = 'info', title } = Astro.props;

/**
 * Omgjord 2026-07-26: bort med accentstrimman.
 *
 * Tidigare bar varje typ en fyra pixlar bred färgad kant till vänster plus en
 * egen bakgrund ur Tailwinds standardpalett (amber-50, rose-50, green-600).
 * Två problem. Strimman som "viktigt"-markör är ett bannat AI-mönster, och
 * standardfärgerna ligger utanför sitens tokens, så rutorna drog iväg från
 * plommon/rosen/papper-paletten så fort de dök upp i brödtexten.
 *
 * Nu: alla fyra typerna delar samma varma yta och samma hela hårlinjeram.
 * Typen signaleras av ETIKETTEN, i sitens egna semantiska tokens. Det är den
 * enda skillnaden som behövs, och den ligger i text i stället för i dekor.
 */
const styles: Record<string, { container: string; label: string; defaultTitle: string }> = {
 tip: {
 container: 'bg-bg-alt border-safe/35',
 label: 'text-safe',
 defaultTitle: 'Tips',
 },
 warning: {
 container: 'bg-bg-alt border-warning/40',
 label: 'text-warning',
 defaultTitle: 'Varning',
 },
 key: {
 container: 'bg-bg-alt border-accent/35',
 label: 'text-accent-dark',
 defaultTitle: 'Viktigt',
 },
 info: {
 container: 'bg-bg-alt border-border-dark',
 label: 'text-text-light',
 defaultTitle: 'Info',
 },
};

const s = styles[type];
const finalTitle = title?? s.defaultTitle;
---

<aside class={`my-6 p-4 rounded-lg border text-text ${s.container}`} role="note">
 {finalTitle && (
 <p class={`font-heading text-xs font-bold uppercase tracking-wide mb-2 ${s.label}`}>{finalTitle}</p>
 )}
 <div class="text-sm leading-relaxed [&>p]:mb-2 last:[&>p]:mb-0">
 <slot />
 </div>
</aside>
