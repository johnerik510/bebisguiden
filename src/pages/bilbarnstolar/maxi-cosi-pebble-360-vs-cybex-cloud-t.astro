 </ul>
 </div>

 <FAQ items={faqItems} />

 <ProductSchema products={[
 { name: 'Cybex Cloud T i-Size', description: 'Babyskydd med 360-rotation och premium sidokrocksskydd. Passar från prematura.', brand: 'Cybex', ratingValue: 4.8, reviewCount: 1 },
 { name: 'Maxi-Cosi Pebble 360 Pro 2', description: 'Babyskydd med 360-rotation och FamilyFix-baskompatibilitet. Uppdaterad version med åtgärdad klädsel.', brand: 'Maxi-Cosi', ratingValue: 4.7, reviewCount: 1 },
 ]} />

