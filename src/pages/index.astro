/** Antalet granskade kategorier räknas alltid ur listan, aldrig hårdkodat. */
const antalKategorier = granskningsomraden.length;

/**
 * Kortordningen är GSC-data, inte magkänsla. Klick per silo senaste 90 dagarna
 * (hämtat 2026-07-26, `gsc.py --site bebisguiden.se --report performance`):
 * blöjor 850, bilbarnstolar 721, barnvagnar 712, amning 384, spjälsängar 309,
 * bärselen 250, babyvakter 176, matstolar 167, leksaker 153, sovsäckar 78.
 * Blöjor var nätets mest klickade silo men saknades helt bland korten.
 */
const toppKategoriHrefs = ['/blojor/', '/bilbarnstolar/', '/barnvagnar/', '/amning/', '/spjalsangar/', '/barselen/'];
const toppKategorier = toppKategoriHrefs
  .map((h) => granskningsomraden.find((o) => o.href === h)!)
  .filter(Boolean);
const ovrigaKategorier = granskningsomraden.filter((o) => !toppKategoriHrefs.includes(o.href));

const guidehubbar = [
 { name: 'Hälsa & symptom', href: '/guider/halsa-och-symptom/', desc: 'Feber, kolik, magont, utslag, när du ska vara orolig och när det är normalt.', anchor: 'Bebishälsa och symptom' },
 { name: 'Sömn', href: '/guider/somn/', desc: 'Säker sovmiljö enligt barnläkarpraxis, sovrutiner och regression.', anchor: 'Guider om bebissömn' },
 { name: 'Mat & amning', href: '/guider/mat-och-amning/', desc: 'Amning, fast föda, BLW och introduktion av allergener.', anchor: 'Guider om amning och mat' },
 { name: 'Utrustning', href: '/guider/utrustning/', desc: 'Vad du faktiskt behöver, och vad du kan hoppa över.', anchor: 'Guider om babyutrustning' },
 { name: 'Förberedelser', href: '/guider/forberedelser/', desc: 'Checklistor inför förlossningen, packlista och graviditetsveckor.', anchor: 'Guider om förberedelser inför bebis' },
];

/**
 * Bäst i test-index. Chips-navigering i stället för en vägg av identiska kort:
 * samma 16 ankartexter, en fjärdedel av ytan, ingen box-på-box.
 */
const bastITestKolumner = [
 {
  rubrik: 'Transport',
  lankar: [
   { name: 'Bästa barnvagnen 2026', href: '/barnvagnar/' },
   { name: 'Bästa bilbarnstolen 2026', href: '/bilbarnstolar/' },
   { name: 'Bästa bärsele 2026', href: '/barselen/' },
  ],
 },
 {
  rubrik: 'Sömn & säkerhet',
  lankar: [
   { name: 'Bedside crib bäst i test 2026', href: '/spjalsangar/bedside-crib/' },
   { name: 'Bästa babyvakten 2026', href: '/babyvakter/' },
   { name: 'Babygrind bäst i test 2026', href: '/sakerhet/babygrindar/' },
   { name: 'Bästa babysittern 2026', href: '/babysitter/' },
  ],
 },
 {
  rubrik: 'Blöjor & kläder',
  lankar: [
   { name: 'Bästa blöjorna 2026', href: '/blojor/' },
   { name: 'Tygblöjor bäst i test 2026', href: '/blojor/tygblojor/' },
   { name: 'Bästa babykläderna 2026', href: '/babyklader/' },
  ],
 },
 {
  rubrik: 'Mat & amning',
  lankar: [
   { name: 'Bröstpump bäst i test 2026', href: '/amning/brostpump/' },
   { name: 'Bästa matstolen 2026', href: '/matstolar/' },
   { name: 'Sterilisator bäst i test 2026', href: '/sterilisatorer/' },
  ],
 },
 {
  rubrik: 'Vardag & lek',
  lankar: [
   { name: 'Bästa lära-gå-stolen 2026', href: '/lara-ga-stol/' },
   { name: 'Bästa aktivitetscentret 2026', href: '/leksaker/aktivitetscenter/' },
   { name: 'Babybadkar bäst i test 2026', href: '/badkar/' },
  ],
 },
];

/** Bedömningskriterierna speglar /sa-testar-vi/. Ingen viktning påstås. */
const kriterier = ['Säkerhet', 'Användarvänlighet', 'Komfort', 'Kvalitet', 'Pris och värde'];

const kallor = ['Folksam', 'ADAC', 'Stiftung Warentest', 'i-Size R129'];

const categoryFallbackImages: Record<string, string> = {
 'Bilbarnstolar': '/images/cat-bilbarnstol.webp',
 'Barnvagnar': '/images/cat-barnvagn.webp',
 'Babyvakter': '/images/cat-babyvakt.webp',
 'Bärselen': '/images/cat-barsele.webp',
 'Matstolar': '/images/cat-matstol.webp',
 'Spjälsängar': '/images/cat-spjalsang.webp',
 'Sovpåsar': '/images/cat-sovsack.webp',
 'Amning': '/images/cat-amning.webp',
 'Blöjor': '/images/cat-bloja.webp',
 'Babykläder': '/images/cat-babyklader.webp',
 'Badkar': '/images/cat-badkar.webp',
 'Leksaker': '/images/cat-leksaker.webp',
 'Sterilisatorer': '/images/cat-sterilisator.webp',
 'Babysitter': '/images/cat-babysitter.webp',
 'Lära-gå-stolar': '/images/cat-lara-ga-stol.webp',
 'Babygrindar': '/images/cat-babygrindar.webp',
 'Guider': '/images/hero-bebis.webp',
}

const allMods = import.meta.glob('./**/*.astro', { eager: true })
type ArtMeta = { title: string; description: string; publishDate: string; category: string; image: string }
const senasteNyheter = Object.entries(allMods)
  .filter(([path, mod]) => path !== './index.astro' && !path.endsWith('/index.astro') && !!(mod as any).articleMeta)
.map(([path, mod]) => {
 const meta = (mod as any).articleMeta as ArtMeta
 const href = '/' + path.replace(/^\.\//, '').replace(/\.astro$/, '/')
 const image = meta.image || categoryFallbackImages[meta.category] || '/images/hero-bebis.webp'
 return {...meta, image, href }
 })
.sort((a, b) => b.publishDate.localeCompare(a.publishDate))
.slice(0, 6)

function fmtDate(d: string) {
 return new Date(d + 'T12:00:00').toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })
}

const senastUppdaterad = senasteNyheter[0]?.publishDate ?? `${now.getFullYear()}-${monthNum}-01`;

const homeFaqItems = [
 {
  question: 'Vad behöver man till bebis?',
  answer: 'Det absolut nödvändiga är: en i-Size-godkänd bilbarnstol (lagkrav för transport från sjukhuset), en trygg sovplats (spjälsäng eller bedside crib) och en barnvagn. Utöver det är bröstpump, nappflaskor och blöjor praktiska att ha hemma i förväg. Leksaker, babysitter och aktivitetscenter kan vänta tills du ser vad barnet faktiskt behöver. Undvik att köpa för mycket innan födseln, de flesta nyfödda har väldigt enkla behov de första veckorna.',
 },
 {
  question: 'Vilken barnvagn är bäst 2026?',
  answer: 'Bugaboo Fox 5 Renew är bäst i test 2026 i vår jämförelse med 4,8 av 5, tack vare multilink-fjädringen och den vändbara sittdelen. Nuna Mixx Next är bästa allroundvalet och Joolz Day5 vinner på design. Cybex EOS Lux är bäst pris/kvalitet i mellansegmentet och lättare för stadsliv, medan Kinderkraft MOOV 2 är budgetvinnaren. Välj duovagn (med liggdel) om du vill ha en vagn som räcker från nyfödd, annars klarar sig en sittvagn om barnet är minst 6 månader.',
 },
 {
  question: 'Vilken bilbarnstol är säkrast?',
  answer: 'Britax Römer Dualfix 5Z toppade <a href="https://www.adac.de/rund-ums-fahrzeug/tests/kindersicherheit/kindersitztest/" target="_blank" rel="noopener nofollow" class="text-accent underline">ADAC:s krocktest</a> och är säkrast totalt med bakåtvänt till 105 cm och 360-graders rotation. Cybex Sirona T är premiumvalet med magnetiskt bälteslås och Linear Side-impact Protection. Alla moderna bilbarnstolar ska uppfylla i-Size R129, den strängaste europeiska standarden, som kräver obligatorisk sidokrocktestning och bakåtvänt minst till 15 månader. Undvik alltid begagnade bilbarnstolar, en osynlig spricka kan innebära att skyddet uteblir vid krock.',
 },
 {
  question: 'Hur länge ska bebis sova i föräldrarnas rum?',
  answer: 'Socialstyrelsen och WHO rekommenderar att bebisen sover i samma rum som föräldrarna men i egen säng de första sex månaderna, helst upp till ett år. Det minskar risken för plötslig spädbarnsdöd (SIDS) med upp till 50 procent. En bedside crib som fästs vid sängen är ett praktiskt kompromiss som gör nattkoll och amning enklare utan att dela säng. Bebisen ska alltid sova på rygg, på fast och plan madrass utan kuddar eller lösa täcken.',
 },
 {
  question: 'Vilken blöja är bäst för nyfödda?',
  answer: 'Pampers New Baby Stl 1 (2 till 5 kg) är bäst för nyfödda tack vare navelurringningen som skyddar det ömma navelsträngsomfånget. Kit & Kin Eco är bäst för känslig hud och ekologiska familjer, fri från klor och parfym. Pampers Premium Protection är starkast på läckageskydd och passar bra från 3 till 4 kg och uppåt. En nyfödd byter blöja 8 till 12 gånger per dygn, köp inte för stora lager i en enda storlek, barnet växer snabbt.',
 },
 {
  question: 'Vilken babyvakt ska man ha?',
  answer: 'Det beror på om du vill ha en lokal DECT-monitor eller en WiFi-kamera du kan kolla via telefon. DECT-monitorer (Philips Avent, Motorola) är enklare, kräver ingen internetuppkoppling och anses av många som säkrare ur integritetssynpunkt. WiFi-kameror (Arlo, Nanit) ger mer funktioner men är beroende av internetuppkoppling och app. Väljer du WiFi, kontrollera alltid att kameran har kryptering och tvåfaktorsautentisering. En babyvakt med temperaturlarm är extra praktiskt under vintermånaderna.',
 },
 {
  question: 'Vad kostar babyutrustning totalt?',
  answer: 'En rimlig totalbudget för det nödvändiga är 15 000 till 30 000 kr: barnvagn (3 000 till 12 000 kr), bilbarnstol (3 000 till 8 000 kr), spjälsäng inklusive madrass (2 000 till 5 000 kr) och övrig utrustning. Väljer du begagnat på barnvagn och spjälsäng och nytt på bilbarnstol och madrass kan du komma ner mot 10 000 kr. Premiumalternativ med helt ny utrustning kan kosta 40 000 till 60 000 kr. Prioritera säkerhet framför pris på bilbarnstol och sovmiljö.',
 },
 {
  question: 'Kan man köpa babyutrustning begagnat?',
  answer: 'Ja, men det finns viktiga undantag. Köp aldrig begagnad bilbarnstol om du inte känner ägaren personligen och vet att den aldrig varit med i krock. Köp aldrig begagnad madrass till spjälsäng av hygienskäl, risken för SIDS ökar med använda madrasser från okänd källa. Barnvagnar, spjälsängar, matstolar och kläder kan köpas begagnat utan problem, de håller generellt länge. Blocket, Facebook Marketplace och Tradera har bra utbud av barnvagnar i bra skick.',
 },
];

---

<BaseLayout
 title="Bebisguiden 2026: bäst i test barnvagn, bilbarnstol, blöjor"
 description="Bebisguiden rankar bästa barnvagnen, bilbarnstolen, blöjorna, bedside crib och bröstpumpen 2026. Krocktester, ADAC, Folksam och i-Size R129 i botten."
>
 <link slot="head" rel="preload" as="image" href="/images/hero-bebis-kvall.webp" type="image/webp" />

 <!-- Hero: foto + EN mörk overlay. Inga orbs, ingen grain, ingen dekorgradient. -->
 <section class="relative overflow-hidden text-white min-h-[380px] md:min-h-[460px] flex items-center">
  <img
   src="/images/hero-bebis-kvall.webp"
   alt="Förälder som håller sin nyfödda bebis i ett vardagsrum på kvällen, med barnvagnen i bakgrunden"
   width="1672"
   height="940"
   class="absolute inset-0 w-full h-full object-cover object-[64%_center] sm:object-center -z-10"
   loading="eager"
   fetchpriority="high"
  />
  <!-- Overlayen är responsiv: på smala skärmar ligger texten över hela fotot och
       behöver mer täckning, på breda sitter den i den naturligt mörka vänsterdelen
       och kan därför släppa fram bilden. Mätt kontrast: se designsystemet. -->
  <div class="absolute inset-0 bg-gradient-to-r from-primary-dark/90 via-primary-dark/84 to-primary-dark/66 md:from-primary-dark/88 md:via-primary-dark/82 md:to-primary-dark/62 lg:from-primary-dark/80 lg:via-primary-dark/58 lg:to-primary-dark/18 -z-10" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 relative w-full">
   <div class="max-w-2xl">
    <p class="text-xs sm:text-[13px] font-semibold uppercase tracking-[0.2em] text-white mb-4">
     Oberoende jämförelser · {antalKategorier} kategorier · uppdaterad {monthYear}
    </p>

    <h1 class="font-heading text-[2rem] leading-[1.1] sm:text-[2.75rem] lg:text-[3.25rem] font-semibold mb-4">
     Barnvagn, bilbarnstol och blöjor bäst i test <span class="text-white/60">2026</span>
    </h1>

    <p class="text-base sm:text-lg text-white/85 leading-relaxed mb-7 max-w-xl">
     Oberoende test av bästa barnvagnen, bilbarnstolen, blöjorna, bedside crib och bröstpumpen 2026.
    </p>

    <div class="flex flex-col sm:flex-row gap-3">
     <a href="/bilbarnstolar/" class="inline-flex items-center justify-center w-full sm:w-auto bg-cta hover:bg-cta-dark text-white font-semibold px-6 py-3.5 rounded-md transition-colors">
      Se bästa bilbarnstolarna
     </a>
     <a href="/barnvagnar/" class="inline-flex items-center justify-center w-full sm:w-auto border border-white/35 hover:bg-white/10 text-white font-semibold px-6 py-3.5 rounded-md transition-colors">
      Bästa barnvagnarna
     </a>
    </div>
   </div>
  </div>
 </section>

 <!-- Snabbsvar + toppval: ETT block, answer-first (GEO/AEO) -->
 <SnabbsvarBox
  question="vad behöver man till bebis?"
  featured={{
   name: featuredProduct.name,
   brand: featuredProduct.brand,
   image: featuredProduct.image,
   imageAlt: 'Bugaboo Fox 5 Renew barnvagn i Heritage Black med liggdel och sittdel',
   badge: featuredProduct.badge,
   rating: featuredProduct.rating,
   bestFor: 'Föräldrar som vill ha en vagn som klarar svenska gator och grus från nyfödd till tre år, med vändbar sittdel och multilink-fjädring.',
   buyUrl: featuredProduct.ctaHref,
   merchant: featuredProduct.merchant,
   reviewHref: '/barnvagnar/',
   reviewLabel: 'Se hela barnvagnsjämförelsen',
  }}
 >
  <p>
   Tre saker behöver du från dag ett: en i-Size-godkänd bilbarnstol, en trygg sovplats och en barnvagn.
   Bland <a href="/barnvagnar/" class="text-accent-dark underline underline-offset-2 hover:text-accent transition-colors">barnvagnarna 2026</a>
   rankar vi Bugaboo Fox 5 Renew högst med 4,8 av 5, Nuna Mixx Next som bästa allroundval och
   Kinderkraft MOOV 2 som budgetvinnare. Resten kan vänta tills du sett vad barnet faktiskt behöver.
  </p>
 </SnabbsvarBox>

 <!-- Kategorier: de mest lästa som kort, resten som chips i SAMMA sektion -->
 <section class="bg-white border-t border-border py-10 sm:py-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
   <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-3">
    <h2 class="font-heading text-2xl sm:text-3xl font-semibold text-primary leading-tight max-w-2xl">
     Hitta din testvinnare per kategori
    </h2>
    <a href="/kategorier/" class="text-[15px] font-semibold text-accent-dark underline underline-offset-2 hover:text-accent transition-colors whitespace-nowrap">
     Se alla {antalKategorier} kategorier
    </a>
